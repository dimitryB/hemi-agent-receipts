# hemi-agent-receipts service configuration. Copy to .env (never commit .env).
# Lines marked SECRET hold private keys: keep them out of logs, tickets and shells' history.
# Everything is validated at startup; the service refuses to start and lists every problem.

# ---------------------------------------------------------------- chain
# 743111 = Hemi testnet (default), 43111 = Hemi mainnet. The RPC's chain id must match.
CHAIN_ID=743111
# Comma-separated, tried in order. Default: the SDK's RPCs for CHAIN_ID.
HEMI_RPC_URLS=https://testnet.rpc.hemi.network/rpc
# The ReceiptRegistry. Its serviceSigner() must be SERVICE_PRIVATE_KEY's address.
REGISTRY_ADDRESS=
# Block the registry was deployed in (lower bound for log lookups). Default 0.
REGISTRY_DEPLOY_BLOCK=

# ---------------------------------------------------------------- keys
# SECRET. Signs BatchAttestation and ServiceAttestation envelopes (the registry's serviceSigner).
SERVICE_PRIVATE_KEY=
# SECRET. Pays gas for attestBatch. Defaults to SERVICE_PRIVATE_KEY. Must hold ETH on Hemi and
# must not be used by anything else: the batcher owns its nonces.
RELAYER_PRIVATE_KEY=

# ---------------------------------------------------------------- HTTP and storage
PORT=8787
# Interface to bind. Default 0.0.0.0.
HOST=
# SQLite file (node:sqlite). In docker compose it is /data/receipts.sqlite on a volume.
DB_PATH=./data/receipts.sqlite
# Base of receiptUrl in responses (e.g. https://receipts.example.com). Default: from the Host header.
PUBLIC_BASE_URL=
# Largest canonical manifest stored when a client sends store: true. 0 disables storage. Default 1048576.
STORE_MANIFESTS_MAX_BYTES=1048576
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- batching and status
# A batch closes at this many receipts (max 65536) ...
BATCH_MAX_SIZE=64
# ... or when its oldest receipt has waited this long, whichever comes first.
BATCH_MAX_WAIT_SECONDS=60
# Hemi blocks on top of the anchoring block before hemi-confirmed (also needs the safe head).
HEMI_CONFIRMATIONS=10
# Status poller interval. Confirmed batches are re-checked less often as they age, up to
# POLL_MAX_INTERVAL_SECONDS, and at most POLL_MAX_BATCHES_PER_TICK batches per tick.
POLL_INTERVAL_SECONDS=15
POLL_MAX_INTERVAL_SECONDS=600
POLL_MAX_BATCHES_PER_TICK=20
# How long a service signature stays valid (the registry allows at most 3600). Default 1800.
SIGNATURE_TTL_SECONDS=1800
# Replace an unmined attestBatch tx (same nonce, +12.5 % fees, capped at 10x the current
# suggestion) after this long, if blocks keep coming without it. Default 180.
STUCK_TX_SECONDS=180

# ---------------------------------------------------------------- Bitcoin finality (SDK defaultFinalityReader)
# off disables Bitcoin stages (btc.source "unavailable"). Default on.
FINALITY=on
# Comma-separated Esplora API bases. Default: the SDK's for CHAIN_ID.
BTC_ESPLORA_URLS=
# Comma-separated BTC addresses of known PoP miners. Default: the SDK's for CHAIN_ID.
POP_MINER_BTC_ADDRESSES=
# Bitcoin blocks to scan for PoP publications when no miner address matches. Default: the SDK's.
BTC_SCAN_MAX_BLOCKS=

# ---------------------------------------------------------------- RPC budget (SDK client)
# Token bucket shared by the batcher, poller and request path. The public RPC allows ~300/min.
RPC_REQUESTS_PER_SECOND=4
RPC_BURST=8
RPC_TIMEOUT_MS=15000
RPC_RETRY_COUNT=6
RPC_RETRY_DELAY_MS=250

# ---------------------------------------------------------------- x402 payments
# 1 = no payment (development only). 0 = POST /attest and /attest/direct require x402 payment.
DEV_FREE=0
# The x402 facilitator (https://github.com/dimitryB/x402facilitator). Must list exact on eip155:<CHAIN_ID>.
FACILITATOR_URL=http://localhost:8080
# Receives payments. Required unless DEV_FREE=1. Not secret.
PAY_TO=
# Prices in the payment asset's base units (USDC.e has 6 decimals: 1000 = $0.001).
PRICE_BATCH=1000
PRICE_DIRECT=10000
# Payment asset. Default USDC.e: testnet 0xD47971C7F5B1067d25cd45d30b2c9eb60de96443 (permit2),
# mainnet 0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA (eip3009, "Bridged USDC (Stargate)" v2).
# Set these only for another asset or chain.
PAYMENT_ASSET=
PAYMENT_ASSET_TRANSFER_METHOD=
PAYMENT_ASSET_EIP712_NAME=
PAYMENT_ASSET_EIP712_VERSION=
